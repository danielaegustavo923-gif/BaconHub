local function descfrom(plr)
    if not plr then return end
    local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if h then
        local ok, live = pcall(function() return h:GetAppliedDescription() end)
        if ok and live and live:IsA("HumanoidDescription") then return live, h.RigType end
    end
    local ok, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(plr.UserId) end)
    if ok and d and d:IsA("HumanoidDescription") then return d, Enum.HumanoidRigType.R15 end
end

local function go(d, r)
    local rem = uh()
    if not rem then return end
    local p = { Action = "CreateAndWearHumanoidDescription", Properties = dict(d), RigType = r or Enum.HumanoidRigType.R15 }
    pcall(function()
        if rem:IsA("RemoteFunction") then rem:InvokeServer(p) else rem:FireServer(p) end
    end)
end

