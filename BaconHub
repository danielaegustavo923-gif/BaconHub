Connections.RenderStepped = RunService.RenderStepped:Connect(function(dt)
local char = LocalPlayer.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")
local hum = char and char:FindFirstChildOfClass("Humanoid")
-- LOOP DO MOTOR DE FÍSICA DO BACON BHOP (Integrado sem supressões)
if isBaconBhopActive and hum and hrp and BaconBhopMovement.mover and not FreecamAtivada and not isFlyActive then
BaconBhopMovement.dt = dt
local isGrounded, isSurfing, result = baconIsGrounded()
BaconBhopMovement.states.grounded = isGrounded or false
BaconBhopMovement.states.surfing = isSurfing or false
if hrp.AssemblyLinearVelocity.Y < 0 then BaconBhopMovement.states.jumping = false end
local rotationLook = hrp.Position + Cam.CFrame.lookVector
hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(rotationLook.X, hrp.Position.Y, rotationLook.Z))
hrp.RotVelocity = Vector3.new()
if BaconBhopMovement.states.jumping or not BaconBhopMovement.states.grounded then
local groundNormal = isSurfing and result.Normal or false
baconApplyAirVelocity()
hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, hrp.AssemblyLinearVelocity.Y - (BaconBhopConfig.GRAVITY * dt), hrp.AssemblyLinearVelocity.Z)
elseif BaconBhopMovement.Keys.Space > 0 then
bhopSounds[math.random(1, #bhopSounds)]:Play()
BaconBhopMovement.states.jumping = true
hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, BaconBhopConfig.JUMP_VELOCITY, hrp.AssemblyLinearVelocity.Z)
baconApplyAirVelocity()
else
baconApplyGroundVelocity(result.Normal)
end
end
if FreecamAtivada and AncoraFreecam then
local camMoveVector = Vector3.new(0, 0, 0)
if UserInputService:IsKeyDown(Enum.KeyCode.W) then camMoveVector = camMoveVector + Cam.CFrame.LookVector end
if UserInputService:IsKeyDown(Enum.KeyCode.S) then camMoveVector = camMoveVector - Cam.CFrame.LookVector end
if UserInputService:IsKeyDown(Enum.KeyCode.A) then camMoveVector = camMoveVector - Cam.CFrame.RightVector end
if UserInputService:IsKeyDown(Enum.KeyCode.D) then camMoveVector = camMoveVector + Cam.CFrame.RightVector end
if UserInputService:IsKeyDown(Enum.KeyCode.Space) then camMoveVector = camMoveVector + Vector3.new(0, 1, 0) end
if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then camMoveVector = camMoveVector - Vector3.new(0, 1, 0) end
if camMoveVector.Magnitude > 0 then
AncoraFreecam.CFrame = AncoraFreecam.CFrame + (camMoveVector.Unit * VelocidadeFreecam)
end
end
if isSpeedBoostActive and not isFlyActive and not FreecamAtivada and not isBaconBhopActive then
if hum and hum.WalkSpeed ~= currentSpeed then hum.WalkSpeed = currentSpeed end
end
if isFlyActive and hrp and hum and not FreecamAtivada then
local flyVelocity = Vector3.new(0, 0, 0)
if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVelocity = flyVelocity + Cam.CFrame.LookVector end
if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVelocity = flyVelocity - Cam.CFrame.LookVector end
if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVelocity = flyVelocity - Cam.CFrame.RightVector end
if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVelocity = flyVelocity + Cam.CFrame.RightVector end
hrp.Velocity = flyVelocity.Magnitude > 0 and flyVelocity.Unit * currentFlySpeed or Vector3.new(0,0,0)
end
if isExpanded and not AutoPlayInocenteAtivado then
for _, p in pairs(Players:GetPlayers()) do
if p ~= LocalPlayer and p.Character then
local enemyHrp = p.Character:FindFirstChild("HumanoidRootPart")
if enemyHrp then
local customBox = p.Character:FindFirstChild("BaconCustomHitbox")
if not customBox then
customBox = Instance.new("Part") customBox.Name = "BaconCustomHitbox"
customBox.Anchored = true customBox.CanCollide = false customBox.Parent = p.Character
end
customBox.Size = currentHitboxSize customBox.CFrame = enemyHrp.CFrame
customBox.Color = currentHitboxColor customBox.Transparency = currentHitboxTransparency
end
end
end
end
if MasterUniversalAimbot and AimbotAtivoPorTecla and not FreecamAtivada then
if AlvoAtualGrudado and (not AlvoAtualGrudado.Parent or AlvoAtualGrudado.Parent:FindFirstChildOfClass("Humanoid").Health <= 0) then AlvoAtualGrudado = nil end
if not AlvoAtualGrudado then AlvoAtualGrudado = obterAlvoAimbotUniversal() end
if AlvoAtualGrudado then Cam.CFrame = CFrame.new(Cam.CFrame.Position, AlvoAtualGrudado.Position) end
end
if PlataformaAtivada and PlataformaObjeto and hrp then PlataformaObjeto.CFrame = CFrame.new(hrp.Position.X, AlturaPlataforma, hrp.Position.Z) end
end)
LocalPlayer.Idled:Connect(function()
if AntiAFKAtivado then VirtualUser:Button2Down(Vector2.new(0,0), Cam.CFrame) task.wait(1) VirtualUser:Button2Up(Vector2.new(0,0), Cam.CFrame) end
end)
Connections.InputBegan = UserInputService.InputBegan:Connect(function(input, gpe)
if UserInputService:GetFocusedTextBox() then return end
-- MAPEAMENTO DO TECLADO DO MOUSE COMPLETO PARA A ENGINE DE FÍSICA DO BHOP
if input.KeyCode and BaconBhopMovement.Keys[input.KeyCode.Name] then
BaconBhopMovement.Keys[input.KeyCode.Name] = 1
end
if PlataformaAtivada and PlataformaObjeto then
if input.KeyCode == Enum.KeyCode.E then
AlturaPlataforma = AlturaPlataforma + VelocidadeElevador
elseif input.KeyCode == Enum.KeyCode.Q then
AlturaPlataforma = AlturaPlataforma - VelocidadeElevador
end
end
if input.KeyCode == Enum.KeyCode.P and UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) and not gpe then
local novoEstado = not FreecamAtivada
toggleFreecam(novoEstado)
pcall(function() freecamToggleSwitch.BackgroundColor3 = novoEstado and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(100, 100, 100) end)
end
if input.KeyCode == AimbotKey and not gpe and MasterUniversalAimbot then
AimbotAtivoPorTecla = not AimbotAtivoPorTecla
if not AimbotAtivoPorTecla then AlvoAtualGrudado = nil end
end
if input.KeyCode == ToggleKey then mainFrame.Visible = not mainFrame.Visible
elseif input.KeyCode == DestroyKey then
for _, conn in pairs(Connections) do if conn then conn:Disconnect() end end
resetAllHitboxes()
if PlataformaObjeto then PlataformaObjeto:Destroy() end
if AFKPlatform then AFKPlatform:Destroy() end
if BaconBhopMovement.mover then BaconBhopMovement.mover:Destroy() end
toggleFreecam(false)
screenGui:Destroy()
end
end)
