local function executarCorrecaoDeTexto(textoBruto)
    if not textoBruto or string.len(textoBruto) == 0 then return "" end
    textoBruto = string.gsub(textoBruto, "o+", "o")
    textoBruto = string.gsub(textoBruto, "a+", "a")
    textoBruto = string.gsub(textoBruto, "e+", "e")
textoBruto = string.gsub(textoBruto, "i+", "i")
textoBruto = string.gsub(textoBruto, "%bvc%", "você")
textoBruto = string.gsub(textoBruto, "%bvcs%", "vocês")
textoBruto = string.gsub(textoBruto, "%bpq%", "porque")
textoBruto = string.gsub(textoBruto, "%boq%", "o que")
textoBruto = string.gsub(textoBruto, "%btbm%", "também")
textoBruto = string.gsub(textoBruto, "%bmt%", "muito")
textoBruto = string.gsub(textoBruto, "%btd%", "tudo")
textoBruto = string.upper(string.sub(textoBruto, 1, 1)) .. string.sub(textoBruto, 2)
local ultimo = string.sub(textoBruto, -1)
if ultimo ~= "." and ultimo ~= "!" and ultimo ~= "?" then textoBruto = textoBruto .. "." end
return textoBruto
end
local function obterAlvoAimbotUniversal()
local menorDistancia = math.huge
local melhorAlvo = nil
local meuChar = LocalPlayer.Character
local meuHrp = meuChar and meuChar:FindFirstChild("HumanoidRootPart")
if not meuHrp then return nil end
for _, jogador in pairs(Players:GetPlayers()) do
if jogador ~= LocalPlayer and jogador.Character and jogador.Character:FindFirstChildOfClass("Humanoid") then
local charInimigo = jogador.Character
local parteAlvo = charInimigo:FindFirstChild(ParteDoCorpoAlvo)
if not parteAlvo and (ParteDoCorpoAlvo == "Torso" or ParteDoCorpoAlvo == "UpperTorso") then
parteAlvo = charInimigo:FindFirstChild("HumanoidRootPart") or charInimigo:FindFirstChild("UpperTorso") or charInimigo:FindFirstChild("Torso")
end
if parteAlvo and parteAlvo:IsA("BasePart") then
local hum = charInimigo:FindFirstChildOfClass("Humanoid")
if hum.Health > 0 then
local _, visivel = Cam:WorldToViewportPoint(parteAlvo.Position)
if visivel then
local dist = (meuHrp.Position - parteAlvo.Position).Magnitude
if dist <= limiteAlcanceUniversal and dist < menorDistancia then
menorDistancia = dist
melhorAlvo = parteAlvo
end
end
end
end
end
end
return melhorAlvo
end
local function obterCorDaFuncaoMM2(player)
local char = player.Character
if not char then return Color3.fromRGB(0, 255, 0) end
for _, item in ipairs(char:GetChildren()) do
if item:IsA("Tool") then
local nome = item.Name:lower()
if nome:find("knife") or nome:find("faca") then return Color3.fromRGB(255, 0, 0) end
if nome:find("gun") or nome:find("arma") then return Color3.fromRGB(0, 0, 255) end
end
end
return Color3.fromRGB(0, 255, 0)
end
local function encontrarMurderNoServidor()
