local function flattenVectorAgainstWall(moveVector, normal)
	if moveVector.Magnitude == 0 and normal.Magnitude == 0 then return Vector3.zero end
	normal = normal.Unit
	local reflected = moveVector - 2 * moveVector:Dot(normal) * normal
	local parallel = moveVector + reflected
	if parallel.Magnitude == 0 then return Vector3.zero end
	return parallel.Unit:Dot(moveVector.Unit) * parallel.Unit * moveVector.Magnitude
end

function BaconBhopMovement:CollideAndSlide(wishedSpeed)
	if wishedSpeed.Magnitude == 0 then return wishedSpeed end
	local inputVec = self.states.input_vec
	local newSpeed = wishedSpeed
	local hrp = LocalPlayer.Character.HumanoidRootPart
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {LocalPlayer.Character, Cam}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.CollisionGroup = "PlayerMovement"

	wishedSpeed *= 2
	local dirAmnt = 1.375
	local mainDirAmnt = 1.55
	local isSticking = false
	local partsAlreadyHit = {}

	local lookVecs = { Vector3.new(0, (-BaconBhopConfig.TORSO_TO_FEET) + BaconBhopConfig.STEP_OFFSET, 0), Vector3.new(0, 0, 0), Vector3.new(0, 2, 0) }

	for _, v in pairs(lookVecs) do
		local values = {}
		local hval = {}
		local currForDir, currSideDir
		local rayPos = hrp.Position + v

		if inputVec.X > 0 then
			currForDir = hrp.CFrame.RightVector table.insert(values, currForDir)
			table.insert(hval, hrp.CFrame.LookVector * dirAmnt) table.insert(hval, -hrp.CFrame.LookVector * dirAmnt)
		elseif inputVec.X < 0 then
			currForDir = -hrp.CFrame.RightVector table.insert(values, currForDir)
			table.insert(hval, hrp.CFrame.LookVector * dirAmnt) table.insert(hval, -hrp.CFrame.LookVector * dirAmnt)
		end

		if inputVec.Z > 0 then
			currSideDir = -hrp.CFrame.LookVector table.insert(values, currSideDir)
			table.insert(hval, hrp.CFrame.RightVector * dirAmnt) table.insert(hval, -hrp.CFrame.RightVector * dirAmnt)
		elseif inputVec.Z < 0 then
			currSideDir = hrp.CFrame.LookVector table.insert(values, currSideDir)
			table.insert(hval, hrp.CFrame.RightVector * dirAmnt) table.insert(hval, -hrp.CFrame.RightVector * dirAmnt)
		end

		if inputVec.Z == 0 and inputVec.X == 0 then
			values[1] = wishedSpeed.Unit
			table.insert(hval, CFrame.new(wishedSpeed.Unit).RightVector * dirAmnt) table.insert(hval, -CFrame.new(wishedSpeed.Unit).RightVector * dirAmnt)
		else
			table.insert(values, wishedSpeed.Unit * dirAmnt)
		end

		if currForDir and currSideDir then
			for a, b in pairs(values) do values[a] = b * mainDirAmnt end
			table.insert(values, (currForDir+currSideDir) * mainDirAmnt)
		else
			values[1] *= mainDirAmnt
			table.insert(values, (values[1] + hval[1]).Unit * mainDirAmnt)
			table.insert(values, (values[1] + hval[2]).Unit * mainDirAmnt)
			table.insert(values, hval[1]) table.insert(values, hval[2])
		end

		for _, b in pairs(values) do
			if not b then continue end
			local result = workspace:Raycast(rayPos, b, params)
			if not result then continue end
			if table.find(partsAlreadyHit, result.Instance) then continue end
			table.insert(partsAlreadyHit, result.Instance)

			local _v =  newSpeed.Unit * result.Normal
			for _, c in pairs({_v.X, _v.Y, _v.Z}) do if math.abs(c) > 0 then _v = c break end end
			if type(_v) == "number" and _v > 0 then continue end

			isSticking = true
			newSpeed = flattenVectorAgainstWall(newSpeed, result.Normal)
			newSpeed -= result.Instance.Velocity
			self.mover.PlaneVelocity = Vector2.new(newSpeed.X, newSpeed.Z)
		end
	end
	return newSpeed
end

local function baconIsGrounded(dir)
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {LocalPlayer.Character, Cam}
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.CollisionGroup = "PlayerMovement"

	local hrp = BaconBhopMovement.collider
	local cf = CFrame.new(hrp.Position) - Vector3.new(0, hrp.Size.Y/2, 0)
	dir = dir or Vector3.new(0,-1 * hrp.Size.Y-BaconBhopConfig.FOOT_OFFSET_AMOUNT,0)

	local result = workspace:Blockcast(cf, BaconBhopConfig.FEET_HB_SIZE, dir, params)
	if not result or not result.Normal then return false end

	local steepness = math.deg(math.acos(result.Normal:Dot(Vector3.yAxis)))
	if type(steepness) ~= "number" or steepness ~= steepness then return false end

	local isSurfing = steepness >= BaconBhopConfig.MIN_SLOPE_ANGLE and steepness <= BaconBhopConfig.MAX_SLOPE_ANGLE
	if isSurfing then return false, true, result, steepness end
	return true, false, result
end

local function baconGetMovementDirection(groundNormal)
	local forward = BaconBhopMovement.Keys.W + -BaconBhopMovement.Keys.S
	local side = BaconBhopMovement.Keys.A + -BaconBhopMovement.Keys.D
	groundNormal = groundNormal or Vector3.new(0,1,0)

	if forward == 0 and side == 0 then
		BaconBhopMovement.states.input_vec = Vector3.zero return Vector3.zero
	else
		BaconBhopMovement.states.input_vec = Vector3.new(-side, 0, -forward).Unit
		local forwardMove = groundNormal:Cross(BaconBhopMovement.collider.CFrame.RightVector)
		local sideMove = groundNormal:Cross(forwardMove)
		return (forwardMove * forward + sideMove * side).Unit
	end
end

local function baconClipVelocity(input, normal, output, overbounce)
	local angle = normal.Y
	local blocked = 0
	if angle > 0 then blocked = 1 end
	if angle == 0 then blocked = 2 end
	local backoff = input:Dot(normal) * overbounce

	local coords = {"X", "Y", "Z"}
	for i = 1, 3 do local ci = coords[i] output[ci] = input[ci] - (normal[ci] * backoff) end
	local adjust = output:ToVector3():Dot(normal)
	if adjust < 0 then output = output:ToVector3() - (normal * adjust) end
	return blocked
end

local function baconTraceReflect(velocity, origin)
	local endp = origin + (velocity * BaconBhopMovement.dt)
	local isGrounded, isSurfing, hit = baconIsGrounded(velocity.Unit * ((origin - endp).Magnitude + 0.1))
	if hit then
		local output = Vec3Mod.new(velocity)
		baconClipVelocity(velocity, hit.Normal, output, 1) return output:ToVector3(), 1
	end
	return velocity, 0
end

local function baconApplyFriction(modifier, inAir)
	local vel = inAir and BaconBhopMovement.collider.Velocity or Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y)
	local speed = vel.Magnitude
	modifier = modifier or 1
	if speed <= 0 then return vel end

	if not inAir and BaconBhopMovement.states.input_vec.Magnitude > 0 and speed > 30 then return vel end
	if not inAir and BaconBhopMovement.states.input_vec.Magnitude == 0 and modifier == 1 then modifier = 8 end

	local fric = inAir and BaconBhopConfig.AIR_FRICTION or BaconBhopConfig.FRICTION
	local control = speed < BaconBhopConfig.GROUND_DECCEL and BaconBhopConfig.GROUND_DECCEL or speed
	local drop = control * fric * BaconBhopMovement.dt * modifier
	if type(drop) ~= "number" then drop = drop.Magnitude end

	local newSpeed = math.max(speed - drop, 0)
	if not inAir and BaconBhopMovement.states.input_vec.Magnitude > 0 then newSpeed = math.max(newSpeed, 30) end
	if speed > 0 and newSpeed > 0 then newSpeed /= speed end
	vel *= newSpeed
	BaconBhopMovement.mover.PlaneVelocity = Vector2.new(vel.X, vel.Z)
end

local function baconApplyGroundVelocity(groundNormal)
	local wishDir = baconGetMovementDirection(groundNormal)
	local wishSpeed = wishDir.Magnitude * BaconBhopConfig.RUN_SPEED
	local currentGroundSpeed = Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y).Magnitude

	if BaconBhopMovement.states.air_friction > 0 and currentGroundSpeed < 5 and wishDir.Magnitude == 0 then
		BaconBhopMovement.states.air_friction = 0
	end
	if BaconBhopMovement.states.air_friction <= 0 then baconApplyFriction(1, false)
	else
		local sub = BaconBhopConfig.AIR_MAX_SPEED_FRIC_DEC * BaconBhopMovement.dt * 60
		local curr = BaconBhopMovement.states.air_friction
		local fric = curr - sub
		baconApplyFriction(math.max(1, fric/BaconBhopConfig.FRICTION), false)
		BaconBhopMovement.states.air_friction = math.max(0, curr - sub)
	end

	local currentVelocity = Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y)
	local currentSpeed = currentVelocity:Dot(wishDir)
	local addSpeed = wishSpeed - currentSpeed
	if addSpeed > 0 then
		local accelerationSpeed = math.min(BaconBhopConfig.GROUND_ACCEL * BaconBhopMovement.dt * wishSpeed, addSpeed)
		local newVelocity = currentVelocity + (accelerationSpeed * wishDir)
		BaconBhopMovement.mover.PlaneVelocity = Vector2.new(newVelocity.X, newVelocity.Z)
	end
	BaconBhopMovement:CollideAndSlide(Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y))
end

local function baconApplyAirVelocity()
	local vel = Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y)
	local wishDir = baconGetMovementDirection(Vector3.new(0,1,0))
	local wishSpeed = wishDir.Magnitude * BaconBhopConfig.AIR_SPEED
	if vel.Magnitude > BaconBhopConfig.AIR_MAX_SPEED then BaconBhopMovement.states.air_friction = BaconBhopConfig.AIR_MAX_SPEED_FRIC end

	if BaconBhopMovement.states.air_friction > 0 and not BaconBhopMovement.states.surfing then baconApplyFriction(0.01 * BaconBhopMovement.states.air_friction, false) end

	local currentVelocity = Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, 0, BaconBhopMovement.mover.PlaneVelocity.Y)
	local currentSpeed = currentVelocity:Dot(wishDir)
	local addSpeed = wishSpeed - currentSpeed
	if addSpeed > 0 then
		local accelerationSpeed = math.min(BaconBhopConfig.AIR_ACCEL * BaconBhopMovement.dt * wishSpeed, addSpeed)
		local newVelocity = currentVelocity + (accelerationSpeed * wishDir)
		BaconBhopMovement.mover.PlaneVelocity = Vector2.new(newVelocity.X, newVelocity.Z)
	end

	local refVel = Vector3.new(BaconBhopMovement.mover.PlaneVelocity.X, BaconBhopMovement.collider.Velocity.Y, BaconBhopMovement.mover.PlaneVelocity.Y)
	local reflected = baconTraceReflect(refVel, BaconBhopMovement.collider.Position)
BaconBhopMovement.mover.PlaneVelocity = Vector2.new(reflected.X, reflected.Z)
end
