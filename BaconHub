local function flattenVectorAgainstWall(moveVector, normal)
if moveVector.Magnitude == 0 and normal.Magnitude == 0 then return Vector3.zero end
normal = normal.Unit
local reflected = moveVector - 2 * moveVector:Dot(normal) * normal
local parallel = moveVector + reflected
if parallel.Magnitude == 0 then return Vector3.zero end
return parallel.Unit:Dot(moveVector.Unit) * parallel.Unit * moveVector.Magnitude
end
local function forsakenCollideAndSlide(wishedSpeed)
if wishedSpeed.Magnitude == 0 then return wishedSpeed end
local inputVec = ForsakenMovement.states.input_vec
local newSpeed = wishedSpeed
local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not hrp then return wishedSpeed end
local params = RaycastParams.new()
params.FilterDescendantsInstances = {LocalPlayer.Character, Cam}
params.FilterType = Enum.RaycastFilterType.Exclude
params.CollisionGroup = "PlayerMovement"
wishedSpeed *= 2
local dirAmnt = 1.375
local mainDirAmnt = 1.55
local isSticking = false
local partsAlreadyHit = {}
local lookVecs = { Vector3.new(0, (-ForsakenConfig.TORSO_TO_FEET) + ForsakenConfig.STEP_OFFSET, 0), Vector3.new(0, 0, 0), Vector3.new(0, 2, 0) }
for _, v in pairs(lookVecs) do
local values = {}
local hval = {}
local currForDir, currSideDir
local rayPos = hrp.Position + v
if inputVec.X > 0 then
currForDir = hrp.CFrame.RightVector table.insert(values, currForDir)
table.insert(hval, hrp.CFrame.LookVector * dirAmnt) table.insert(hval, -hrp.CFrame.LookVector * dirAmnt)
elseif inputVec.X < 0 then
currForDir = -hrp.CFrame.RightVector table.insert(values, currForDir)
table.insert(hval, hrp.CFrame.LookVector * dirAmnt) table.insert(hval, -hrp.CFrame.LookVector * dirAmnt)
end
if inputVec.Z > 0 then
currSideDir = -hrp.CFrame.LookVector table.insert(values, currSideDir)
table.insert(hval, hrp.CFrame.RightVector * dirAmnt) table.insert(hval, -hrp.CFrame.RightVector * dirAmnt)
elseif inputVec.Z < 0 then
currSideDir = hrp.CFrame.LookVector table.insert(values, currSideDir)
table.insert(hval, hrp.CFrame.RightVector * dirAmnt) table.insert(hval, -hrp.CFrame.RightVector * dirAmnt)
end
if inputVec.Z == 0 and inputVec.X == 0 then
values = wishedSpeed.Unit
table.insert(hval, CFrame.new(wishedSpeed.Unit).RightVector * dirAmnt) table.insert(hval, -CFrame.new(wishedSpeed.Unit).RightVector * dirAmnt)
else
table.insert(values, wishedSpeed.Unit * dirAmnt)
end
if currForDir and currSideDir then
for a, b in pairs(values) do values[a] = b * mainDirAmnt end
table.insert(values, (currForDir+currSideDir) * mainDirAmnt)
else
values *= mainDirAmnt
table.insert(values, (values + hval).Unit * mainDirAmnt)
table.insert(values, (values + hval).Unit * mainDirAmnt)
table.insert(values, hval) table.insert(values, hval)
end
for _, b in pairs(values) do
if not b then continue end
local result = workspace:Raycast(rayPos, b, params)
if not result then continue end
if table.find(partsAlreadyHit, result.Instance) then continue end
table.insert(partsAlreadyHit, result.Instance)
local _v =  newSpeed.Unit * result.Normal
for _, c in pairs({_v.X, _v.Y, _v.Z}) do if math.abs(c) > 0 then _v = c break end end
if type(_v) == "number" and _v > 0 then continue end
isSticking = true
newSpeed = flattenVectorAgainstWall(newSpeed, result.Normal)
newSpeed -= result.Instance.Velocity
if ForsakenMovement.mover then ForsakenMovement.mover.PlaneVelocity = Vector2.new(newSpeed.X, newSpeed.Z) end
end
end
return newSpeed
end
local function forsakenIsGrounded(dir)
local params = RaycastParams.new()
params.FilterDescendantsInstances = {LocalPlayer.Character, Cam}
params.FilterType = Enum.RaycastFilterType.Exclude
params.CollisionGroup = "PlayerMovement"
local hrp = ForsakenMovement.collider
if not hrp then return false end
local cf = CFrame.new(hrp.Position) - Vector3.new(0, hrp.Size.Y/2, 0)
dir = dir or Vector3.new(0, -1 * hrp.Size.Y - ForsakenConfig.FOOT_OFFSET_AMOUNT, 0)
local result = workspace:Blockcast(cf, ForsakenConfig.FEET_HB_SIZE, dir, params)
if not result or not result.Normal then return false end
local steepness = math.deg(math.acos(result.Normal:Dot(Vector3.yAxis)))
if type(steepness) ~= "number" or steepness ~= steepness then return false end
local isSurfing = steepness >= ForsakenConfig.MIN_SLOPE_ANGLE and steepness <= ForsakenConfig.MAX_SLOPE_ANGLE
if isSurfing then return false, true, result, steepness end
return true, false, result
end
local function forsakenGetMovementDirection(groundNormal)
local forward = ForsakenMovement.Keys.W + -ForsakenMovement.Keys.S
local side = ForsakenMovement.Keys.A + -ForsakenMovement.Keys.D
groundNormal = groundNormal or Vector3.new(0,1,0)
if forward == 0 and side == 0 then
ForsakenMovement.states.input_vec = Vector3.zero
return Vector3.zero
else
ForsakenMovement.states.input_vec = Vector3.new(-side, 0, -forward).Unit
local forwardMove = groundNormal:Cross(ForsakenMovement.collider.CFrame.RightVector)
local sideMove = groundNormal:Cross(forwardMove)
return (forwardMove * forward + sideMove * side).Unit
end
end
local function forsakenClipVelocity(input, normal, output, overbounce)
local angle = normal.Y
local blocked = 0
if angle > 0 then blocked = 1 end
if angle == 0 then blocked = 2 end
local backoff = input:Dot(normal) * overbounce
local coords = {"X", "Y", "Z"}
for i = 1, 3 do
local ci = coords[i]
output[ci] = input[ci] - (normal[ci] * backoff)
end
local adjust = output:ToVector3():Dot(normal)
if adjust < 0 then output = output:ToVector3() - (normal * adjust) end
return blocked
end
local function forsakenTraceReflect(velocity, origin)
local endp = origin + (velocity * ForsakenMovement.dt)
local isGrounded, isSurfing, hit = forsakenIsGrounded(velocity.Unit * ((origin - endp).Magnitude + 0.1))
if hit then
local output = Vec3Mod.new(velocity)
forsakenClipVelocity(velocity, hit.Normal, output, 1)
return output:ToVector3(), 1
end
return velocity, 0
end
local function forsakenApplyFriction(modifier, inAir)
local vel = inAir and ForsakenMovement.collider.Velocity or Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y)
local speed = vel.Magnitude
modifier = modifier or 1
if speed <= 0 then return vel end
if not inAir and ForsakenMovement.states.input_vec.Magnitude > 0 and speed > 30 then return vel end
if not inAir and ForsakenMovement.states.input_vec.Magnitude == 0 and modifier == 1 then modifier = 8 end
local fric = inAir and ForsakenConfig.AIR_FRICTION or ForsakenConfig.FRICTION
local control = speed < ForsakenConfig.GROUND_DECCEL and ForsakenConfig.GROUND_DECCEL or speed
local drop = control * fric * ForsakenMovement.dt * modifier
if type(drop) ~= "number" then drop = drop.Magnitude end
local newSpeed = math.max(speed - drop, 0)
if not inAir and ForsakenMovement.states.input_vec.Magnitude > 0 then newSpeed = math.max(newSpeed, 30) end
if speed > 0 and newSpeed > 0 then newSpeed /= speed end
vel *= newSpeed
ForsakenMovement.mover.PlaneVelocity = Vector2.new(vel.X, vel.Z)
end
local function forsakenApplyGroundVelocity(groundNormal)
local wishDir = forsakenGetMovementDirection(groundNormal)
local wishSpeed = wishDir.Magnitude * ForsakenConfig.RUN_SPEED
local currentGroundSpeed = Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y).Magnitude
if ForsakenMovement.states.air_friction > 0 and currentGroundSpeed < 5 and wishDir.Magnitude == 0 then
ForsakenMovement.states.air_friction = 0
end
if ForsakenMovement.states.air_friction <= 0 then
forsakenApplyFriction(1, false)
else
local sub = ForsakenConfig.AIR_MAX_SPEED_FRIC_DEC * ForsakenMovement.dt * 60
local curr = ForsakenMovement.states.air_friction
local fric = curr - sub
forsakenApplyFriction(math.max(1, fric/ForsakenConfig.FRICTION), false)
ForsakenMovement.states.air_friction = math.max(0, curr - sub)
end
local currentVelocity = Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y)
local currentSpeed = currentVelocity:Dot(wishDir)
local addSpeed = wishSpeed - currentSpeed
if addSpeed > 0 then
local accelerationSpeed = math.min(ForsakenConfig.GROUND_ACCEL * ForsakenMovement.dt * wishSpeed, addSpeed)
local newVelocity = currentVelocity + (accelerationSpeed * wishDir)
ForsakenMovement.mover.PlaneVelocity = Vector2.new(newVelocity.X, newVelocity.Z)
end
forsakenCollideAndSlide(Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y))
end
local function forsakenApplyAirVelocity()
local vel = Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y)
local wishDir = forsakenGetMovementDirection(Vector3.new(0,1,0))
local wishSpeed = wishDir.Magnitude * ForsakenConfig.AIR_SPEED
if vel.Magnitude > ForsakenConfig.AIR_MAX_SPEED then ForsakenMovement.states.air_friction = ForsakenConfig.AIR_MAX_SPEED_FRIC end
if ForsakenMovement.states.air_friction > 0 and not ForsakenMovement.states.surfing then forsakenApplyFriction(0.01 * ForsakenMovement.states.air_friction, false) end
local currentVelocity = Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, 0, ForsakenMovement.mover.PlaneVelocity.Y)
local currentSpeed = currentVelocity:Dot(wishDir)
local addSpeed = wishSpeed - currentSpeed
if addSpeed > 0 then
local accelerationSpeed = math.min(ForsakenConfig.AIR_ACCEL * ForsakenMovement.dt * wishSpeed, addSpeed)
local newVelocity = currentVelocity + (accelerationSpeed * wishDir)
ForsakenMovement.mover.PlaneVelocity = Vector2.new(newVelocity.X, newVelocity.Z)
end
local refVel = Vector3.new(ForsakenMovement.mover.PlaneVelocity.X, ForsakenMovement.collider.Velocity.Y, ForsakenMovement.mover.PlaneVelocity.Y)
local reflected = forsakenTraceReflect(refVel, ForsakenMovement.collider.Position)
ForsakenMovement.mover.PlaneVelocity = Vector2.new(reflected.X, reflected.Z)
end
local function initForsakenEngine()
ForsakenMovement.collider = LocalPlayer.Character:WaitForChild("HumanoidRootPart")
local mover = ForsakenMovement.collider:FindFirstChild("ForsakenMoverAttachment")
if not mover then
