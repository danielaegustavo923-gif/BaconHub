local function uh()
    local e = ReplicatedStorage:FindFirstChild("Events")
    if e then
        local r = e:FindFirstChild("CatalogGuiRemote")
        if r then return r end
    end
    local r = ReplicatedStorage:FindFirstChild("CatalogGuiRemote")
    if r then return r end
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
