local function rgb(c)
    if typeof(c) ~= "Color3" then
        return {r = 255, g = 255, b = 255, IsRGBTable = true}
    end
    return {r = c.R * 255, g = c.G * 255, b = c.B * 255, IsRGBTable = true}
end

